{
  "name": "bot-rider",
  "displayName": "Bot Rider",
  "description": "A Copilot-powered swarm of persona bots that debate, then propose workspace edits for review.",
  "version": "0.1.0",
  "publisher": "botrider",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/praveeninbasekaran/bot-rider.git"
  },
  "engines": {
    "vscode": "^1.99.0"
  },
  "categories": [
    "Chat",
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "vitest run",
    "test:watch": "vitest",
    "vscode:prepublish": "npm run compile",
    "package:vsix": "node scripts/package-vsix.mjs",
    "test:extension": "node scripts/run-extension-tests.mjs",
    "test:vsix": "node scripts/vsix-smoke.mjs",
    "graphify:check": "node scripts/graphify-freshness.mjs --check",
    "graphify:stamp": "node scripts/graphify-freshness.mjs --write",
    "release:gate": "node scripts/release-gate.mjs"
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.13.10",
    "@types/vscode": "^1.99.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "jsdom": "^29.1.1",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  },
  "contributes": {
    "commands": [
      {
        "command": "botrider.bots.create",
        "title": "New Bot",
        "category": "Bot Rider",
        "icon": "$(add)"
      },
      {
        "command": "botrider.bots.edit",
        "title": "Edit Bot",
        "category": "Bot Rider",
        "icon": "$(edit)"
      },
      {
        "command": "botrider.bots.delete",
        "title": "Delete Bot",
        "category": "Bot Rider",
        "icon": "$(trash)"
      },
      {
        "command": "botrider.bots.toggle",
        "title": "Toggle Active",
        "category": "Bot Rider"
      },
      {
        "command": "botrider.chat.expand",
        "title": "Expand",
        "category": "Bot Rider",
        "icon": "$(screen-full)"
      },
      {
        "command": "botrider.chat.stop",
        "title": "Stop",
        "category": "Bot Rider",
        "icon": "$(debug-stop)"
      },
      {
        "command": "botrider.changeset.approve",
        "title": "Approve",
        "tooltip": "Apply file changes",
        "category": "Bot Rider",
        "icon": "$(check)"
      },
      {
        "command": "botrider.changeset.reject",
        "title": "Reject",
        "tooltip": "Reject and discard all proposed edits",
        "category": "Bot Rider",
        "icon": "$(discard)"
      },
      {
        "command": "botrider.review.openDiff",
        "title": "Open Diff",
        "category": "Bot Rider",
        "icon": "$(diff)"
      },
      {
        "command": "botrider.split.continue",
        "title": "Continue",
        "category": "Bot Rider"
      },
      {
        "command": "botrider.split.pick",
        "title": "Pick a Bot to Decide",
        "category": "Bot Rider"
      },
      {
        "command": "botrider.copilot.recheck",
        "title": "Sign in to GitHub Copilot",
        "category": "Bot Rider"
      },
      {
        "command": "botrider.onboarding.reopen",
        "title": "Open Getting Started",
        "category": "Bot Rider"
      },
      {
        "command": "botrider.changeset.retry",
        "title": "Retry",
        "category": "Bot Rider",
        "icon": "$(refresh)",
        "enablement": "botrider.applyFailed"
      },
      {
        "command": "botrider.mcp.approve",
        "title": "Approve",
        "tooltip": "Run MCP actions",
        "category": "Bot Rider",
        "icon": "$(check)",
        "enablement": "botrider.hasPendingMcp"
      },
      {
        "command": "botrider.mcp.reject",
        "title": "Reject",
        "tooltip": "Reject and discard staged MCP actions",
        "category": "Bot Rider",
        "icon": "$(discard)",
        "enablement": "botrider.hasPendingMcp"
      },
      {
        "command": "botRider.bots.export",
        "title": "Export Bot",
        "category": "Bot Rider"
      },
      {
        "command": "botRider.bots.exportSelected",
        "title": "Export Selected",
        "category": "Bot Rider"
      },
      {
        "command": "botRider.bots.exportAll",
        "title": "Export All",
        "category": "Bot Rider"
      },
      {
        "command": "botRider.bots.import",
        "title": "Import",
        "category": "Bot Rider",
        "icon": "$(desktop-download)"
      },
      {
        "command": "botrider.contextMap.refresh",
        "title": "Refresh",
        "category": "Bot Rider",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "botrider.bots.edit",
          "when": "false"
        },
        {
          "command": "botrider.bots.delete",
          "when": "false"
        },
        {
          "command": "botrider.bots.toggle",
          "when": "false"
        },
        {
          "command": "botrider.review.openDiff",
          "when": "false"
        },
        {
          "command": "botrider.split.continue",
          "when": "botrider.splitOpen"
        },
        {
          "command": "botrider.split.pick",
          "when": "botrider.splitOpen"
        },
        {
          "command": "botrider.chat.stop",
          "when": "botrider.debateRunning || botrider.splitOpen"
        },
        {
          "command": "botrider.changeset.retry",
          "when": "botrider.applyFailed"
        },
        {
          "command": "botrider.mcp.approve",
          "when": "botrider.hasPendingMcp"
        },
        {
          "command": "botrider.mcp.reject",
          "when": "botrider.hasPendingMcp"
        },
        {
          "command": "botRider.bots.export",
          "when": "false"
        },
        {
          "command": "botRider.bots.exportSelected",
          "when": "view == botrider.bots && listHasSelectionOrFocus"
        },
        {
          "command": "botRider.bots.exportAll",
          "when": "botrider.hasBots"
        }
      ],
      "view/title": [
        {
          "command": "botrider.bots.create",
          "when": "view == botrider.bots",
          "group": "navigation"
        },
        {
          "command": "botRider.bots.import",
          "when": "view == botrider.bots",
          "group": "navigation"
        },
        {
          "command": "botRider.bots.exportAll",
          "when": "view == botrider.bots && botrider.hasBots"
        },
        {
          "command": "botRider.bots.exportSelected",
          "when": "view == botrider.bots && listHasSelectionOrFocus"
        },
        {
          "command": "botrider.chat.expand",
          "when": "view == botrider.chat && !botrider.chatExpanded",
          "group": "navigation"
        },
        {
          "command": "botrider.chat.stop",
          "when": "view == botrider.chat && (botrider.debateRunning || botrider.splitOpen)",
          "group": "navigation"
        },
        {
          "command": "botrider.changeset.approve",
          "when": "view == botrider.review && botrider.hasPendingChanges",
          "group": "navigation@1"
        },
        {
          "command": "botrider.changeset.reject",
          "when": "view == botrider.review && botrider.hasPendingChanges",
          "group": "navigation@2"
        },
        {
          "command": "botrider.mcp.approve",
          "when": "view == botrider.review && botrider.hasPendingMcp && !botrider.mcpFailed",
          "group": "navigation@1"
        },
        {
          "command": "botrider.mcp.reject",
          "when": "view == botrider.review && botrider.hasPendingMcp && !botrider.mcpFailed",
          "group": "navigation@2"
        },
        {
          "command": "botrider.changeset.retry",
          "when": "view == botrider.review && botrider.applyFailed",
          "group": "navigation@3"
        },
        {
          "command": "botrider.contextMap.refresh",
          "when": "view == botrider.contextMap",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "botRider.bots.export",
          "when": "view == botrider.bots && viewItem == bot",
          "group": "1_export"
        },
        {
          "command": "botrider.bots.edit",
          "when": "view == botrider.bots && viewItem == bot",
          "group": "inline@1"
        },
        {
          "command": "botrider.bots.delete",
          "when": "view == botrider.bots && viewItem == bot",
          "group": "1_modification"
        },
        {
          "command": "botrider.changeset.approve",
          "when": "view == botrider.review && viewItem == reviewFilesSection",
          "group": "inline@1"
        },
        {
          "command": "botrider.changeset.reject",
          "when": "view == botrider.review && viewItem == reviewFilesSection",
          "group": "inline@2"
        },
        {
          "command": "botrider.mcp.approve",
          "when": "view == botrider.review && viewItem == reviewMcpSection && !botrider.mcpFailed",
          "group": "inline@1"
        },
        {
          "command": "botrider.mcp.reject",
          "when": "view == botrider.review && viewItem == reviewMcpSection && !botrider.mcpFailed",
          "group": "inline@2"
        },
        {
          "command": "botrider.review.openDiff",
          "when": "view == botrider.review && viewItem == proposedFile",
          "group": "inline"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "botrider",
          "title": "Bot Rider",
          "icon": "media/activitybar.svg"
        }
      ]
    },
    "views": {
      "botrider": [
        {
          "id": "botrider.bots",
          "name": "Bots"
        },
        {
          "id": "botrider.chat",
          "name": "Swarm",
          "type": "webview"
        },
        {
          "id": "botrider.contextMap",
          "name": "Context Map",
          "type": "webview",
          "visibility": "visible"
        },
        {
          "id": "botrider.review",
          "name": "Proposed Changes",
          "visibility": "collapsed"
        }
      ]
    },
    "configuration": {
      "title": "Bot Rider",
      "properties": {
        "botrider.maxCopilotConcurrency": {
          "type": "number",
          "default": 4,
          "minimum": 1,
          "maximum": 16,
          "description": "Maximum number of Copilot requests Bot Rider runs concurrently."
        },
        "botrider.debate.quorumPercent": {
          "type": "number",
          "default": 60,
          "minimum": 1,
          "maximum": 100,
          "description": "Percentage of active bots required for an ordinary Debate decision."
        },
        "botrider.debate.maxAutomaticRounds": {
          "type": "number",
          "default": 2,
          "minimum": 1,
          "maximum": 5,
          "description": "Maximum automatic proposal/synthesis/objection cycles before user escalation."
        },
        "botrider.debate.blockingClasses": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "security",
            "privacy",
            "data-loss"
          ],
          "description": "Concrete objection classes that block an otherwise passing Debate decision."
        },
        "botrider.debate.highRiskKeywords": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "security",
            "credential",
            "payment",
            "privacy",
            "delete",
            "migration"
          ],
          "description": "Request keywords that reserve unanimity for high-risk decisions."
        },
        "botrider.maxVisibleArticles": {
          "type": "number",
          "default": 3,
          "minimum": 1,
          "maximum": 12,
          "description": "Maximum bot response disclosures kept expanded in parallel runs."
        }
      }
    },
    "viewsWelcome": [
      {
        "view": "botrider.bots",
        "contents": "No bots yet. Create a bot with a name, persona, and role, then send a master prompt in Swarm.\n[New Bot](command:botrider.bots.create)\n[Import](command:botRider.bots.import)",
        "when": "!botrider.hasBots"
      },
      {
        "view": "botrider.review",
        "contents": "No proposed edits. After the swarm agrees, proposed WorkspaceEdits appear here for review.\nSelect files, then Approve applies the selected batch. Reject discards it.",
        "when": "!botrider.hasPendingChanges && !botrider.hasPendingMcp"
      }
    ]
  }
}
